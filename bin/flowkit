#!/usr/bin/env bash
# flowkit — CLI entry point for dPeluChe/skills: the skills + hooks + flow layer.
# Pure dispatch: every subcommand forwards to scripts/install.sh, which owns ALL
# the logic. This script only resolves its own real location (it normally runs
# through a ~/bin symlink) and maps subcommands to installer flags.
set -euo pipefail

resolve_self() { # portable readlink -f: follow symlinks to the real script path
  local src="$1" dir target
  while [[ -L "$src" ]]; do
    dir="$(cd "$(dirname "$src")" && pwd)"
    target="$(readlink "$src")"
    case "$target" in
      /*) src="$target" ;;
      *)  src="$dir/$target" ;;
    esac
  done
  dir="$(cd "$(dirname "$src")" && pwd)"
  printf '%s/%s\n' "$dir" "$(basename "$src")"
}

SELF="$(resolve_self "${BASH_SOURCE[0]}")"
REPO_DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
INSTALL="$REPO_DIR/scripts/install.sh"
[[ -f "$INSTALL" ]] || { echo "x flowkit: scripts/install.sh not found under $REPO_DIR" >&2; exit 1; }

fk_version() { # prints "flowkit <VERSION> (<short sha>)"
  local v sha
  v="$(cat "$REPO_DIR/VERSION" 2>/dev/null || echo 0.0.0)"
  sha="$(git -C "$REPO_DIR" rev-parse --short HEAD 2>/dev/null || echo unknown)"
  printf 'flowkit %s (%s)\n' "$v" "$sha"
}

usage() {
  echo "$(fk_version) -- manager for the skills + hooks + flow layer"
  cat <<'EOF'

Usage: flowkit <subcommand>

  install    sync all skills into the symlink chain (~/.claude -> ~/.agents -> repo)
  check      doctor mode -- validate every link, change nothing (exit 0/1)
  prune      sync + remove orphan links left by renamed/deleted skills
  hooks      wire centralized git hooks into the repo you are standing in ($PWD) [--team] [--include-parent]
             --verify: check the EFFECTIVE hook state (config + hooksPath + merged jobs
             + gitleaks config in use + canary secret probe), exit 0/1
  unhook     clean removal from $PWD: lefthook stubs, OUR config files, OUR exclude entries
  upgrade    report lefthook/gitleaks versions + clone freshness (exit 1 if pending);
             inside a wired repo it also refreshes that repo's lefthook remotes cache
  lint-health [path]  audit a JS/TS/React repo's lint gate for false greens: blanket
             eslint-disable, rules turned off in config, unreasoned/ignored source (advisory, exit 0)
             --measure '<rule>': force <rule> on (no config change) + count what it would reveal
  loc-health [path]  audit file sizes repo-wide against the loc_limit rule (ship config,
             default 500); advisory, exit 0. The pre-commit hook warns per-diff too
  about      what flowkit is + this repo's detected flow status (for agents landing cold)
  version    print flowkit version + repo short sha
  help       show this help

process repo: github.com/dPeluChe/skills
EOF
}

cmd="${1:-help}"
[[ $# -gt 0 ]] && shift

# `flowkit <subcommand> --help` shows this help instead of leaking the flag
# into the installer (which used to die with "unknown --repo option: --help")
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

case "$cmd" in
  install) exec bash "$INSTALL" "$@" ;;
  check)   exec bash "$INSTALL" --check "$@" ;;
  prune)   exec bash "$INSTALL" --prune "$@" ;;
  hooks)   exec bash "$INSTALL" --repo "$PWD" "$@" ;;
  unhook)  exec bash "$INSTALL" --unhook "$PWD" "$@" ;;
  upgrade) exec bash "$INSTALL" --upgrade "$@" ;;
  lint-health) exec bash "$INSTALL" --lint-health "$@" ;;
  loc-health)  exec bash "$INSTALL" --loc-health "$@" ;;
  about)   exec bash "$INSTALL" --about "$@" ;;
  version|--version|-v) fk_version ;;
  help|-h|--help) usage ;;
  *)
    usage >&2
    echo "" >&2
    echo "x unknown subcommand: $cmd" >&2
    exit 1
    ;;
esac
